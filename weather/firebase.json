{
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    },
    {
      "source": "radar-functions",
      "codebase": "radar"
    }
  ],
  "hosting": {
    "target": "weather",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/pagasa",
        "function": {
          "functionId": "pagasaWeatherData",
          "region": "asia-southeast1"
        }
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=300"
          }
        ]
      }
    ]
  }
}
